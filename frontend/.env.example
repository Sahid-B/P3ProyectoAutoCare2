# Copia este archivo como .env y ajusta los valores segun tu entorno.
VITE_API_URL=http://localhost:3000/api

# Client ID publico de Google, para el boton "Continuar con Google".
# Las variables VITE_* se incorporan durante el build del frontend, por lo que
# debe estar definida ANTES de ejecutar "vite build" (o el servidor de desarrollo).
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
