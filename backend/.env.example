# Copia este archivo como .env y ajusta los valores segun tu entorno.
# NUNCA subas el archivo .env real (esta en .gitignore). Usa valores ficticios aqui.
PORT=3000
NODE_ENV=development

# Con Docker Compose el host es el nombre del servicio: database
# Para ejecucion local sin Docker usa: localhost
DB_HOST=database
DB_PORT=5432
DB_NAME=autocare
DB_USER=autocare_user
DB_PASSWORD=change_this_password

FRONTEND_URL=http://localhost:5173

# JWT. En produccion usa un valor largo y aleatorio. Si no se define y
# NODE_ENV=production, el backend se detiene con un error claro.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h

# Google OAuth 2.0. El Client ID es publico. El Client Secret NO se usa en este
# flujo (Google Identity Services entrega un ID token que el backend verifica).
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# SMTP para el segundo factor por correo (opcional). Si no se configura, el envio
# de correo se desactiva de forma controlada y el backend arranca igual.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=AutoCare <your_email@example.com>
