# Copia este archivo como .env y ajusta los valores segun tu entorno.
PORT=3000

# Con Docker Compose el host es el nombre del servicio: database
# Para ejecucion local sin Docker usa: localhost
DB_HOST=database
DB_PORT=5432
DB_NAME=autocare
DB_USER=autocare_user
DB_PASSWORD=change_this_password

FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
