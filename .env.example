# Variables usadas por docker-compose.yml.
# Copia este archivo como .env en la raiz del proyecto.
DB_NAME=autocare
DB_USER=autocare_user
DB_PASSWORD=change_this_password

# Dejar en true. Solo poner en false si un antivirus o proxy corporativo
# intercepta las conexiones HTTPS y npm falla al construir las imagenes
# con el error UNABLE_TO_VERIFY_LEAF_SIGNATURE.
NPM_STRICT_SSL=true
