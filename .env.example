# Variables usadas por docker-compose.yml (sustitucion de entorno).
# Copia este archivo como .env en la raiz del proyecto. NUNCA subas el .env real.

# Base de datos
DB_NAME=autocare
DB_USER=autocare_user
DB_PASSWORD=change_this_password

# JWT (se pasa al backend). Usa un valor largo y aleatorio.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h

# Google OAuth 2.0 (Client ID publico). GOOGLE_CLIENT_ID lo usa el backend;
# VITE_GOOGLE_CLIENT_ID lo usa el frontend (se incorpora al build).
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# SMTP para el segundo factor por correo (opcional).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=AutoCare <your_email@example.com>

# --- Pasarela de pagos del modulo de repuestos ---
#
# PayPal Sandbox (opcional). Se obtienen en https://developer.paypal.com creando
# una app REST de tipo Sandbox. Si ambas variables estan vacias, PayPal no se
# ofrece como metodo de pago. NUNCA pongas credenciales reales en este archivo.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Host de la API. Sandbox por defecto; produccion seria https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Modo de pago simulado, solo para desarrollo. Con NODE_ENV=production se ignora.
# Permite completar una compra de prueba sin credenciales de PayPal.
PAGOS_MODO_SIMULADO=true
PAGOS_MONEDA=USD

# Dejar en true. Solo poner en false si un antivirus o proxy corporativo
# intercepta las conexiones HTTPS y npm falla al construir las imagenes.
NPM_STRICT_SSL=true
